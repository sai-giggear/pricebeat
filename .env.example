# Copy to .env (Bun loads it from the working directory). All optional.

# Where the database lives. Default: %LOCALAPPDATA%\PriceBeat\price_tracker.db
# DATABASE_PATH=C:\path\to\price_tracker.db

# Seconds between requests to the same competitor site.
SCRAPE_DELAY_SECONDS=1.0
# How many competitor sites are fetched in parallel during a run.
MAX_CONCURRENT_HOSTS=8
# Price history older than this many days is pruned (0 keeps everything).
SNAPSHOT_RETENTION_DAYS=180
# API port for `bun run start` / `bun run dev`.
PORT=8000
# Set to 1 to stop the hourly background sweep (handy in dev).
# DISABLE_SCHEDULER=1
