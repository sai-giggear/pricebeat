DATABASE_URL=sqlite:///price_tracker.db
# Delay between requests to the same competitor host (politeness).
SCRAPE_DELAY_SECONDS=1.0
# How many competitor hosts are fetched in parallel during a tracking run.
MAX_CONCURRENT_HOSTS=8
# Price history older than this many days is pruned (0 disables pruning).
SNAPSHOT_RETENTION_DAYS=180
